<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon. Android 8+ masks the foreground to whatever shape the
  launcher uses (circle, squircle, rounded square), so the mark is drawn
  inside the safe zone by tool/make_icon.mjs rather than filling the layer.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
