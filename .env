# LogisticDigi environment template.
#
# Copy to `.env.local` (gitignored) and fill in the blanks. Values already
# filled in below are safe to publish; blank ones are secrets.
#
# On the Firebase web config: these six values are shipped to every browser
# in the client bundle and are public by design. They identify the project,
# they do not authorise anything. Access is controlled by Firestore security
# rules and Auth, not by hiding the API key.

# ---------- Firebase (client, public) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAadfnJszpgiPUoqslGfirIFXiAV1k0W6k
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=logisticdigi.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=logisticdigi
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=logisticdigi.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=732824107426
NEXT_PUBLIC_FIREBASE_APP_ID=1:732824107426:web:9a948327a1e18b7328dafb

# ---------- Firebase Admin (server, SECRET) ----------
# Service account for the orchestrator. It bypasses security rules, so this
# is the most sensitive credential in the project. Never commit it.
# Generate: Firebase console > Project settings > Service accounts.
# Paste the JSON as a single line, or point to a file outside the repo.
FIREBASE_SERVICE_ACCOUNT_JSON=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCtii9npPll0BPc\nnPXzNq3LQ20Zm9CXpTomuvBwu1qxPIwG1CI/YE+7v3nAO0rWwATaJF/md7qtC4mf\n8gbWjhlFkxNZicu4/wIGCnBnPqKasMdP/Go0hwT8GpNDMoM5hyzDu5TqTcTkh3Bv\n3VdeY1yQkCUCRI79fAsZq0P1jygFOGjw75r9tfOSm5coxtJix7ZKTID1J7IAvuSa\nNIW4ewMZE/8veswPtwlga6ITLccEiUiIcjmx8qKmwYrlaaY2izwd4Beo//LOF8AE\nj/PsbmnYY2jJm8M9t+EEZB9X5qe2zrF92E/5bPVFOJ3+LzqzizycDmAHEu6NylFu\ncRhUYLxBAgMBAAECggEAGCEtKzugo9v1TwkSF7HEI42qB1QHgnZqagU3Nm2OlDNH\ngxGO+4HwRDpA+w4jf02uvwgsv3ZpYfNHPRKhicazU9255IrI5V2r0dw0ud5XLKwk\n4oXF3KzjcAxf6omE/oRBoKud7qBGnsIIS72ajtjA/6bTRofy2+MaBgUuy1+O4H63\nPG+BXERHWy184qs28cNI/XhsfxATTw2Q7niHwtT/onrHyKGrn6zGF3io+np4CQ0m\nfQ4N6sZDZZqhGAHx+kQIUhJqKaML+tLnn0AUdyRr0K0nPtwNCzdOnJDWbdXXJ1BH\ndsio1gOxaD9bEfREfgQqFS5aiRjY8CbJWKjEmKYGWQKBgQDfyNQ11bdj2jRXJQs5\nEu5TbpAERROPN1dsued0OyBGlao+v6aMckDrYx3OJi2JPwxzq2vQWPDPTt8XP1+N\nPHhMUvXcj1m4WKlBHWqGErHRnjAGHgePWiUfdxYKPe6fTh9FBl01pLIkM51hplOk\nW042wTJvBNCrUJtw1wK5MKxzVQKBgQDGha3PGjXxoGqB0ZVf8jGbItQoFdSbRnNs\nIdRms1B4HvCbKNazEZoVRg78DZrLy+M+kpc4F0cgeiTCqDcwDK9760H82BLgNnMh\n87K/DEQBZEykuzDBVMPo/AWk4MNtseXx6HRbaxAm9zSS7pjIcOn2Wg2h4q9uoQxk\nk0Um0JY9PQKBgCbiwt1H8cIMHKQ376dPPtKIl8XmKuvr9ekStMFhtM4PG7Ijo1Es\nWVONuZQk1izPI97Fnsppag7b6bAkdvoX09+PWuGklzaNUXvbHLOHdBa0oiut9CpY\nw7KgAthswpY0AQMBhBjaMYpQ3bwmJsqcgw7Iq3bXI1themE1O2fqqUyxAoGBAJu2\nzR8uMvPE3OXYy67HXOuPhROwE+R7fRtq6ZxouAyQUC+T99vbSZ24JxbDYRDLawJw\nnxZLA+pQhDb/FNKmkJrFbCv0G9IsQ2B1M1YxO8JPtuJbRaHPaB9+Vrr95axMJs35\nhBMUxkWaD23UophOIOWvuxOop+xBfGQDM/F/GOkNAoGAY7K/po+EE5q/z56mzdDU\nIyDEw7shy6WaLMwqw1ZKl7Vvzd4FENJ1Ykjd8N2K4YwirWltA95B7dR2snVopN0/\nA+P+ViPaltHSCym8UoQtGNUKsJA8hUyykX2xC1zRBf7DrDCWy/AsqF8ypuMxYSHs\nI3whK0Zm4fYuUZwBzOEyMoY=\n-----END PRIVATE KEY-----\n
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- Zerion (Settlement agent's real wallet-data check) ----------
# Free tier: https://dashboard.zerion.io (2,000 calls/day). Zerion indexes
# EVM chains + Solana, not Algorand, so it cannot see or verify this app's
# own facilitator wallet — it is called as a second, honestly-separate real
# tool call the Settlement agent makes after settling, against a public demo
# wallet (ZERION_DEMO_WALLET, defaults to a well-known Ethereum address).
# Blank = the check is skipped, not faked; the Algorand payment still settles.
ZERION_API_KEY=zk_8476e132dbd04f69b39c527de75834d7
ZERION_DEMO_WALLET=


# ---------- Algorand (TestNet) ----------
# Public node endpoints. No key needed for the Nodely free tier.
ALGOD_SERVER=https://testnet-api.4160.nodely.dev
ALGOD_PORT=443
ALGOD_TOKEN=
INDEXER_SERVER=https://testnet-idx.4160.nodely.dev
ALGORAND_NETWORK=testnet
# USDC on Algorand TestNet.
USDC_ASSET_ID=10458941

# The facilitator's wallet, used to verify and settle x402 payments.
# TESTNET ONLY. Fund it from https://bank.testnet.algorand.network
# Never place a MainNet mnemonic here, and never commit this file.
FACILITATOR_MNEMONIC=

# ---------- LLM providers ----------
# Cloud is Gemini — no Claude API available this phase, so ANTHROPIC_API_KEY
# below is unused; nothing in the code reads it anymore. Local is Ollama:
# install it (https://ollama.com) and `ollama pull` LLM_LOCAL_MODEL, and the
# negotiation dialogue works with no cloud key at all. Used by
# services/orchestrator/src/llm/client.ts's routedClient() for the
# `negotiate` step's real agent-to-agent dialogue — see negotiate-llm.ts.
GEMINI_API_KEY=AQ.Ab8RN6LweYKC6MVh41EKfIIweSksyOsEb38ah--Wusr-XsikRg
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
# AQ.Ab8RN6LUnc1H8vxkHmB90ZWxuid8R3agRUdTD_gBIq2_-6bZjQ
# AQ.Ab8RN6JiM63zFPEJMu6dPUUMGRaUWNCTZX2M8rbVT0fjC-vRqw


OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_LOCAL_MODEL=qwen2.5:0.5b
# cloud | local | hybrid — hybrid tries Gemini first, falls back to Ollama on
# any failure (missing key, network error, timeout, empty response).
LLM_ROUTE=hybrid

# ---------- Mapbox (3D dashboard map) ----------
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------- Orchestrator runtime ----------
# Identifies this runner in lease ownership and the trace.
RUNNER_ID=local:dev
# Shared secret the local worker presents to the tick endpoint.
WORKER_SHARED_SECRET=
# Deterministic seed for the provider simulator. Fixed so eval runs replay.
SIM_SEED=42
